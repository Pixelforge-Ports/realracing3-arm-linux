          "Android/data/com.ea.games.r3_row/vehicles/*",
          "Android/data/com.ea.games.r3_row/gui/*"
        ],
        "strip_prefix": "Android/data/com.ea.games.r3_row/"
      }
    },
    {
      "id": "appdata-depot-package",
      "description": "game data from a package folder backup, as archive.org distributes it",
      "required": false,
      "destination": "data",
      "source": {
        "kind": "entries",
        "patterns": [
          "com.ea.games.r3_row/.depot/*"
