        "kind": "entries",
        "patterns": [
          "Android/data/com.ea.games.r3_row/.depot/*"
        ],
        "strip_prefix": "Android/data/com.ea.games.r3_row/.depot/"
      }
    },
    {
      "id": "appdata-depot-data",
      "description": "game data from an extracted Android/ folder whose root strips the Android/ prefix",
      "required": false,
      "destination": "data",
      "source": {
        "kind": "entries",
        "patterns": [
          "data/com.ea.games.r3_row/.depot/*"
        ],
        "strip_prefix": "data/com.ea.games.r3_row/.depot/"
      }
    },
    {
      "id": "appdata-depot-bare",
      "description": "game data from the depot folder on its own",
      "required": false,
      "destination": "data",
      "source": {
        "kind": "entries",
        "patterns": [
          ".depot/*"
        ],
        "strip_prefix": ".depot/"
      }
    }
