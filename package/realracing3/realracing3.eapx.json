      "id": "native-library",
      "description": "Real Racing 3 2.7.0 native library, from the APK",
      "destination": "data/lib/{abi}/libRealRacing3.so",
      "source": {
        "kind": "entry",
        "patterns": [
          "lib/{abi}/libRealRacing3.so",
          "*/lib/{abi}/libRealRacing3.so"
        ]
      }
    },
    {
      "id": "fmod-library",
      "description": "FMOD Ex audio library shipped inside the same APK",
      "destination": "data/lib/{abi}/libfmodex.so",
      "source": {
        "kind": "entry",
        "patterns": [
          "lib/{abi}/libfmodex.so",
          "*/lib/{abi}/libfmodex.so"
        ]
      }
    },
    {
      "id": "appdata-android-files",
      "description": "downloaded content tree, from Android/data/com.ea.games.r3_row/files",
      "required": false,
      "destination": "data",
      "source": {
        "kind": "entries",
        "patterns": [
          "Android/data/com.ea.games.r3_row/files/*"
        ],
        "strip_prefix": "Android/data/com.ea.games.r3_row/files/"
      }
    },
    {
      "id": "appdata-data-files",
      "description": "downloaded content tree, from data/com.ea.games.r3_row/files",
      "required": false,
      "destination": "data",
